# Copy to .env (local) and set the same names in Netlify > Site settings > Environment variables.
# Names only; never commit real values.

# --- Public (inlined in the browser bundle at build time) ---
# Optional: shown as a mailto fallback when the form fails. Omit to hide the fallback.
PUBLIC_CONTACT_EMAIL=
# Optional: enables the Cloudflare Turnstile widget on the form.
PUBLIC_TURNSTILE_SITE_KEY=

# --- Server only (Netlify Function; never exposed to the browser) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Optional: "true" sends an auto-reply to the sender.
CONTACT_AUTOREPLY=
# Optional: when set, the function verifies the Turnstile token.
TURNSTILE_SECRET_KEY=
