---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { locales, t, type Lang } from '../i18n';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Alternate-language paths when slugs differ per language. */
  alternates?: Partial<Record<Lang, string>>;
  publishedTime?: string;
}
const { title, description, lang, image, type, noindex, alternates, publishedTime } = Astro.props;
const fullTitle = title === t(lang, 'site.name') ? title : `${title} | ${t(lang, 'site.name')}`;
---

<!doctype html>
<html lang={locales[lang].html} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#08090a" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <SEO
      title={fullTitle}
      description={description ?? t(lang, 'site.description')}
      {lang}
      {image}
      {type}
      {noindex}
      {alternates}
      {publishedTime}
    />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">{t(lang, 'nav.skipToContent')}</a>
    <Header {lang} {alternates} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer {lang} />
  </body>
</html>
