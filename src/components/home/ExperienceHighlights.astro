---
import Section from '../Section.astro';
import Button from '../Button.astro';
import Timeline from '../experience/Timeline.astro';
import { homeCopy } from '../../data/home-copy';
import { localizedPath, type Lang } from '../../i18n';
import { experienceCopy, positions } from '../../data/experience-copy';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = homeCopy[lang].experience;
const x = experienceCopy[lang];
const labels = { current: c.current, viewCase: x.viewCase, stack: x.stackLabel, impact: x.impactLabel, details: x.detailsLabel };
// Highlights: positions with documented impacts.
const items = positions.filter((p) => p.impacts);
---

<Section id="experience" eyebrow={c.eyebrow} title={c.title} description={c.description}>
  <Timeline positions={items} {lang} {labels} compact />
  <p class="more" data-reveal>
    <Button href={localizedPath(lang, 'experience')} variant="secondary" data-event="view_experience">{c.cta}</Button>
  </p>
</Section>

<style>
  .more {
    margin-top: var(--space-6);
  }
</style>
