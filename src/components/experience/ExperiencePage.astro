---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../Section.astro';
import Button from '../Button.astro';
import Reveal from '../Reveal.astro';
import Timeline from './Timeline.astro';
import { experienceCopy, positions, education, certifications, languages } from '../../data/experience-copy';
import { localizedPath, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = experienceCopy[lang];
const labels = { current: c.current, viewCase: c.viewCase, stack: c.stackLabel, impact: c.impactLabel, details: c.detailsLabel };
---

<BaseLayout title={c.title} description={c.description} {lang}>
  <Section pageTitle eyebrow={c.eyebrow} title={c.heading} description={c.lead} class="first">
    <Timeline {positions} {lang} {labels} />
  </Section>

  <Section id="education" title={c.education.title} description={c.education.description}>
    <ul role="list" class="grid">
      {
        education.map((e, i) => (
          <li class="card" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <h3>{e.name[lang]}</h3>
            <p class="year">{e.institution} · {e.period}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="certifications" title={c.certifications.title}>
    <ul role="list" class="grid">
      {
        certifications.map((name, i) => (
          <li class="card" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <h3>{name}</h3>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="languages" title={c.languages.title}>
    <ul role="list" class="grid">
      {
        languages.map((l, i) => (
          <li class="card" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <h3>{l.name[lang]}</h3>
            <p class="year">{l.level[lang]}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <section class="end">
    <div class="wrap" data-reveal>
      <p>{c.cta.text}</p>
      <Button href={localizedPath(lang, 'contact')} data-event="experience_contact">{c.cta.contact}</Button>
    </div>
  </section>
  <Reveal />
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }
  .card {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    justify-items: start;
    padding: var(--space-5);
    background: var(--color-surface);
    border: var(--border);
    border-radius: var(--radius-lg);
    transition: border-color var(--duration-base) var(--ease-out);
  }
  .card:hover {
    border-color: var(--color-border-strong);
  }
  .year {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }
  .desc {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .end {
    padding-bottom: var(--section-gap);
  }
  .wrap {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
    font-size: var(--text-lg);
  }
</style>
