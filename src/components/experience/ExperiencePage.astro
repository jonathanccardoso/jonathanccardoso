---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../Section.astro';
import Button from '../Button.astro';
import Reveal from '../Reveal.astro';
import Timeline from './Timeline.astro';
import { getWorkItems } from '../../lib/content';
import { experienceCopy, otherProjects } from '../../data/experience-copy';
import { localizedPath, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = experienceCopy[lang];
const all = await getWorkItems(lang);
const employment = all.filter((i) => i.data.type === 'employment');
const products = all.filter((i) => i.data.type === 'product');
---

<BaseLayout title={c.title} description={c.description} {lang}>
  <Section eyebrow={c.eyebrow} title={c.heading} description={c.lead} class="first">
    <h2 class="sub">{c.employmentTitle}</h2>
    <Timeline items={employment} {lang} currentLabel={c.current} viewCase={c.viewCase} />
  </Section>

  {
    products.length > 0 && (
      <Section id="products" title={c.productTitle}>
        <Timeline items={products} {lang} currentLabel={c.current} viewCase={c.viewCase} />
      </Section>
    )
  }

  <Section id="other" title={c.otherTitle} description={c.otherDescription}>
    <ul role="list" class="grid">
      {
        otherProjects.map((p, i) => (
          <li class="card" data-reveal style={`--reveal-delay: ${i * 70}ms`}>
            <h3>{p.name}</h3>
            <p class="year">{p.year}</p>
            <p class="desc">{p.desc[lang]}</p>
            <a href={p.link} target="_blank" rel="noopener noreferrer">
              {c.visit}<span class="sr-only"> {p.name} ({lang === 'pt' ? 'abre em nova aba' : 'opens in a new tab'})</span>
              <span aria-hidden="true"> ↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <section class="end">
    <div class="wrap" data-reveal>
      <p>{c.cta.text}</p>
      <Button href={localizedPath(lang, 'contact')} data-event="experience_contact">{c.cta.contact}</Button>
    </div>
  </section>
  <Reveal />
</BaseLayout>

<style>
  .sub {
    font-size: var(--text-xl);
    margin-bottom: var(--space-5);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }
  .card {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    justify-items: start;
    padding: var(--space-5);
    background: var(--color-surface);
    border: var(--border);
    border-radius: var(--radius-lg);
    transition: border-color var(--duration-base) var(--ease-out);
  }
  .card:hover {
    border-color: var(--color-border-strong);
  }
  .year {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }
  .desc {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  .end {
    padding-bottom: var(--section-gap);
  }
  .wrap {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
    font-size: var(--text-lg);
  }
</style>
