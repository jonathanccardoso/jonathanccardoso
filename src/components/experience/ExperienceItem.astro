---
import Tag from '../Tag.astro';
import { localizedPath, type Lang } from '../../i18n';
import type { Position } from '../../data/experience-copy';

interface Props {
  position: Position;
  lang: Lang;
  labels: { current: string; viewCase: string; stack: string; impact: string; details: string };
  /** Home highlights: only summary and impacts (no details or stack). */
  compact?: boolean;
  delay?: number;
}
const { position: p, lang, labels, compact = false, delay = 0 } = Astro.props;
const current = !!p.current;
const href = p.caseKey ? localizedPath(lang, `work/${p.caseKey}`) : undefined;
const details = compact ? [] : (p.details?.[lang] ?? []);
const impacts = p.impacts?.[lang] ?? [];
const stack = compact ? [] : (p.stack ?? []);
---

<li class:list={['item', { current }]} data-reveal style={`--reveal-delay: ${delay}ms`}>
  <article>
    <header class="head">
      <h3>{p.company}</h3>
      {current && <span class="badge">{labels.current}</span>}
      {
        p.website && !compact && (
          <a class="site" href={p.website} target="_blank" rel="noopener noreferrer">
            {new URL(p.website).hostname} <span aria-hidden="true">↗</span>
            <span class="sr-only"> ({p.company})</span>
          </a>
        )
      }
      {p.location && <p class="period">{p.location[lang]}</p>}
      {p.total && <p class="period">{p.total[lang]}</p>}
    </header>
    <ul role="list" class="roles">
      {
        p.roles.map((r) => (
          <li>
            <span class="role">{r.title}</span> <span class="period">{r.period[lang]}</span>
          </li>
        ))
      }
    </ul>
    <p class="summary">{p.summary[lang]}</p>
    {
      details.length > 0 && (
        <div>
          <h4>{labels.details}</h4>
          <ul class="bullets">
            {details.map((d) => (
              <li>{d}</li>
            ))}
          </ul>
        </div>
      )
    }
    {
      impacts.length > 0 && (
        <div>
          <h4>{labels.impact}</h4>
          <ul class="bullets impact">
            {impacts.map((d) => (
              <li>{d}</li>
            ))}
          </ul>
        </div>
      )
    }
    {
      stack.length > 0 && (
        <ul role="list" class="tags" aria-label={labels.stack}>
          {stack.map((x) => (
            <li>
              <Tag>{x}</Tag>
            </li>
          ))}
        </ul>
      )
    }
    {
      href && (
        <a class="more" href={href}>
          {labels.viewCase}
          <span class="sr-only">: {p.company}</span> <span aria-hidden="true">→</span>
        </a>
      )
    }
  </article>
</li>

<style>
  .site {
    color: var(--color-accent);
    font-size: var(--text-sm);
  }
  .item {
    position: relative;
    list-style: none;
    padding: 0 0 var(--space-6) var(--space-6);
    border-left: var(--border);
    margin-left: var(--space-2);
  }
  .item:last-child {
    padding-bottom: 0;
  }
  .item::before {
    content: '';
    position: absolute;
    left: -0.3125rem;
    top: 0.5rem;
    width: 0.5625rem;
    height: 0.5625rem;
    border-radius: var(--radius-full);
    background: var(--color-border-strong);
  }
  .current::before {
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-accent-soft);
  }
  article {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding: var(--space-5);
    background: var(--color-surface);
    border: var(--border);
    border-radius: var(--radius-lg);
    transition: border-color var(--duration-base) var(--ease-out), background var(--duration-base) var(--ease-out);
  }
  article:hover {
    border-color: var(--color-border-strong);
    background: var(--color-surface-hover);
  }
  .current article {
    border-color: var(--color-accent);
    background: linear-gradient(135deg, var(--color-accent-soft), var(--color-surface) 60%);
  }
  .current h3 {
    font-size: var(--text-2xl);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  .badge {
    padding: 0 var(--space-3);
    border-radius: var(--radius-full);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }
  .period,
  .role {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }
  .summary {
    color: var(--color-text-muted);
  }
  .roles {
    display: grid;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }
  .role {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }
  h4 {
    font-size: var(--text-sm);
    font-family: var(--font-mono);
    color: var(--color-text-subtle);
    margin-bottom: var(--space-2);
  }
  .bullets {
    margin: 0;
    padding-left: var(--space-5);
    display: grid;
    gap: var(--space-1);
    color: var(--color-text-muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding: 0;
    list-style: none;
  }
  .tags {
    gap: var(--space-2);
  }
  .more {
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }
  .more:hover {
    text-decoration: underline;
  }
</style>
