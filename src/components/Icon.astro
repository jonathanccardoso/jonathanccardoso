---
import { iconPaths, type IconName } from './icons';

interface Props {
  name: IconName;
  size?: number;
  /** Accessible label. If omitted the icon is decorative (aria-hidden). */
  label?: string;
}
const { name, size = 20, label } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="currentColor"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <path d={iconPaths[name]}></path>
</svg>
